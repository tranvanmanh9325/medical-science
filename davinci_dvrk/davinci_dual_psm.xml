<mujoco model="davinci_dual_psm_system">
  <compiler angle="radian" coordinate="local" meshdir="../dvrk_model_official"/>

  <default>
    <joint damping="1.5" armature="0.05" frictionloss="0.05"/>
    <geom friction="1.2 0.005 0.0001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <position kp="600" kv="60" forcerange="-100 100"/>
  </default>

  <asset>
    <!-- Medical Grade High-Fidelity Materials -->
    <material name="davinci_white" rgba="0.94 0.95 0.97 1.0" specular="0.75" shininess="0.85" reflectance="0.1"/>
    <material name="davinci_metallic" rgba="0.82 0.85 0.88 1.0" specular="0.95" shininess="0.95" reflectance="0.25"/>
    <material name="davinci_dark" rgba="0.18 0.20 0.23 1.0" specular="0.5" shininess="0.5"/>
    <material name="davinci_gold" rgba="0.85 0.70 0.22 1.0" specular="0.85" shininess="0.85" reflectance="0.15"/>
    <material name="davinci_blue" rgba="0.20 0.45 0.85 1.0" specular="0.8" shininess="0.8"/>

    <!-- Official Meshes from Johns Hopkins dVRK Package -->
    <mesh name="USM_base" file="meshes/arms/Si/USM/USM_base.stl"/>
    <mesh name="USM_yaw" file="meshes/arms/Si/USM/USM_yaw.stl"/>
    <mesh name="USM_pitch" file="meshes/arms/Si/USM/USM_pitch.stl"/>
    <mesh name="USM_pitch_3" file="meshes/arms/Si/USM/USM_pitch_3.stl"/>
    <mesh name="USM_pitch_4" file="meshes/arms/Si/USM/USM_pitch_4.stl"/>
    <mesh name="housing_Si" file="meshes/instruments/housing/Si/housing_Si.obj"/>
    <mesh name="roll_4670" file="meshes/instruments/roll/4670/roll_4670.obj" scale="0.1 0.1 0.1"/>
    <mesh name="wrist_pitch_0091" file="meshes/instruments/wrist_pitch/0091/wrist_pitch_0091.obj" scale="0.1 0.1 0.1"/>
    <mesh name="wrist_yaw_0091" file="meshes/instruments/wrist_yaw/0091/wrist_yaw_0091.obj"/>
    <mesh name="tip_006_1" file="meshes/instruments/tip/006/tip_006_1.obj"/>
    <mesh name="tip_006_2" file="meshes/instruments/tip/006/tip_006_2.obj"/>
  </asset>

  <worldbody>
    <!-- ==================== DUAL-ARM SURGICAL PATIENT CART ==================== -->
    <body name="patient_side_cart" pos="0 -0.85 0">
      <!-- Main Cart Column & Boom -->
      <geom name="cart_pedestal" type="cylinder" size="0.32 0.04" pos="0 0 0.04" material="davinci_dark"/>
      <geom name="cart_tower" type="cylinder" size="0.065 0.45" pos="0 0 0.49" material="davinci_white"/>
      <geom name="cart_boom_crossbar" type="box" size="0.30 0.05 0.04" pos="0 0 0.94" material="davinci_dark"/>

      <!-- ==================== LEFT ARM: PSM1 (Large Needle Driver) ==================== -->
      <body name="psm1_setup_mount" pos="-0.22 0.0 0.94" quat="0.9659 0 0 0.2588">
        <geom pos="0 0 0" quat="0.707107 0 0 0.707107" type="mesh" material="davinci_white" mesh="USM_base"/>
        
        <body name="psm1_yaw_link" pos="0 0.158 0" quat="0.707107 0 0 0.707107">
          <inertial pos="0.1461 0.090363 -0.024957" mass="1.7571" diaginertia="0.022 0.020 0.003"/>
          <joint name="psm1_yaw" range="-1.57 1.57" axis="-1 0 0" damping="1.5"/>
          <geom type="mesh" material="davinci_white" mesh="USM_yaw"/>

          <body name="psm1_pitch_link" pos="0.2987 0 -0.071222" quat="-3.09791e-06 -0.537315 1.97367e-06 -0.843382">
            <inertial pos="0.083895 -0.00073113 -0.028998" mass="4.017" diaginertia="0.026 0.025 0.012"/>
            <joint name="psm1_pitch" range="-0.92 0.92" axis="0 -1 0" damping="1.5"/>
            <geom type="mesh" material="davinci_gold" mesh="USM_pitch"/>

            <body name="psm1_pitch_2_link" pos="0.2032 0 0" quat="-3.30142e-06 -0.438389 1.61029e-06 -0.898786">
              <inertial pos="0.11824 0 0.12932" mass="2.1982" diaginertia="0.032 0.029 0.005"/>
              <geom type="mesh" material="davinci_white" mesh="USM_pitch_3"/>

              <body name="psm1_pitch_3_link" pos="0.35966 0 0.16013" quat="0.999489 0 -0.031976 0">
                <inertial pos="0.041219 0 0.13651" mass="0.752" diaginertia="0.018 0.018 0.001"/>
                <geom type="mesh" material="davinci_white" mesh="USM_pitch_4"/>

                <!-- PSM1 Trocar Insertion -->
                <body name="psm1_adaptor_link" pos="0.115238 0 0.310955" quat="0 0 -1 0">
                  <inertial pos="0 0 0" mass="0.5" diaginertia="0.01 0.01 0.01"/>
                  <joint name="psm1_insertion" type="slide" range="0 0.28" axis="0 0 1" damping="2.0"/>
                  <geom quat="0.5 0.5 -0.5 0.5" type="mesh" material="davinci_white" mesh="housing_Si"/>

                  <!-- PSM1 EndoWrist Roll -->
                  <body name="psm1_roll_link" pos="0 0 0.467">
                    <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
                    <joint name="psm1_roll" range="-4.53 4.53" axis="0 0 1" damping="0.5"/>
                    <geom pos="0 0 0.02975" quat="0.707107 -0.707107 0 0" type="mesh" material="davinci_metallic" mesh="roll_4670"/>

                    <!-- PSM1 Wrist Pitch -->
                    <body name="psm1_wrist_pitch_link" quat="0.5 -0.5 -0.5 -0.5">
                      <inertial pos="0 0 0" mass="0.02" diaginertia="0.0005 0.0005 0.0005"/>
                      <joint name="psm1_wrist_pitch" range="-1.39 1.39" axis="0 0 1" damping="0.2"/>
                      <geom pos="0.0295 0 0" quat="0.5 0.5 0.5 0.5" type="mesh" material="davinci_metallic" mesh="wrist_pitch_0091"/>

                      <!-- PSM1 Wrist Yaw -->
                      <body name="psm1_wrist_yaw_link" pos="0.0091 0 0" quat="0.5 -0.5 -0.5 -0.5">
                        <inertial pos="0 0 0" mass="0.02" diaginertia="0.0005 0.0005 0.0005"/>
                        <joint name="psm1_wrist_yaw" range="-1.39 1.39" axis="0 0 1" damping="0.2"/>
                        <geom pos="0 0 -0.000236" type="mesh" material="davinci_dark" mesh="wrist_yaw_0091"/>

                        <!-- PSM1 Jaws (Needle Driver) -->
                        <body name="psm1_jaw_1_link">
                          <inertial pos="0 0 0" mass="0.01" diaginertia="0.0001 0.0001 0.0001"/>
                          <joint name="psm1_jaw_1" range="0 0.8" axis="0 0 1" damping="0.1"/>
                          <geom type="mesh" material="davinci_metallic" mesh="tip_006_1"/>
                        </body>
                        <body name="psm1_jaw_2_link">
                          <inertial pos="0 0 0" mass="0.01" diaginertia="0.0001 0.0001 0.0001"/>
                          <joint name="psm1_jaw_2" range="0 0.8" axis="0 0 -1" damping="0.1"/>
                          <geom type="mesh" material="davinci_metallic" mesh="tip_006_2"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== RIGHT ARM: PSM2 (ProGrasp Forceps) ==================== -->
      <body name="psm2_setup_mount" pos="0.22 0.0 0.94" quat="0.9659 0 0 -0.2588">
        <geom pos="0 0 0" quat="0.707107 0 0 0.707107" type="mesh" material="davinci_white" mesh="USM_base"/>
        
        <body name="psm2_yaw_link" pos="0 0.158 0" quat="0.707107 0 0 0.707107">
          <inertial pos="0.1461 0.090363 -0.024957" mass="1.7571" diaginertia="0.022 0.020 0.003"/>
          <joint name="psm2_yaw" range="-1.57 1.57" axis="-1 0 0" damping="1.5"/>
          <geom type="mesh" material="davinci_white" mesh="USM_yaw"/>

          <body name="psm2_pitch_link" pos="0.2987 0 -0.071222" quat="-3.09791e-06 -0.537315 1.97367e-06 -0.843382">
            <inertial pos="0.083895 -0.00073113 -0.028998" mass="4.017" diaginertia="0.026 0.025 0.012"/>
            <joint name="psm2_pitch" range="-0.92 0.92" axis="0 -1 0" damping="1.5"/>
            <geom type="mesh" material="davinci_blue" mesh="USM_pitch"/>

            <body name="psm2_pitch_2_link" pos="0.2032 0 0" quat="-3.30142e-06 -0.438389 1.61029e-06 -0.898786">
              <inertial pos="0.11824 0 0.12932" mass="2.1982" diaginertia="0.032 0.029 0.005"/>
              <geom type="mesh" material="davinci_white" mesh="USM_pitch_3"/>

              <body name="psm2_pitch_3_link" pos="0.35966 0 0.16013" quat="0.999489 0 -0.031976 0">
                <inertial pos="0.041219 0 0.13651" mass="0.752" diaginertia="0.018 0.018 0.001"/>
                <geom type="mesh" material="davinci_white" mesh="USM_pitch_4"/>

                <!-- PSM2 Trocar Insertion -->
                <body name="psm2_adaptor_link" pos="0.115238 0 0.310955" quat="0 0 -1 0">
                  <inertial pos="0 0 0" mass="0.5" diaginertia="0.01 0.01 0.01"/>
                  <joint name="psm2_insertion" type="slide" range="0 0.28" axis="0 0 1" damping="2.0"/>
                  <geom quat="0.5 0.5 -0.5 0.5" type="mesh" material="davinci_white" mesh="housing_Si"/>

                  <!-- PSM2 EndoWrist Roll -->
                  <body name="psm2_roll_link" pos="0 0 0.467">
                    <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
                    <joint name="psm2_roll" range="-4.53 4.53" axis="0 0 1" damping="0.5"/>
                    <geom pos="0 0 0.02975" quat="0.707107 -0.707107 0 0" type="mesh" material="davinci_metallic" mesh="roll_4670"/>

                    <!-- PSM2 Wrist Pitch -->
                    <body name="psm2_wrist_pitch_link" quat="0.5 -0.5 -0.5 -0.5">
                      <inertial pos="0 0 0" mass="0.02" diaginertia="0.0005 0.0005 0.0005"/>
                      <joint name="psm2_wrist_pitch" range="-1.39 1.39" axis="0 0 1" damping="0.2"/>
                      <geom pos="0.0295 0 0" quat="0.5 0.5 0.5 0.5" type="mesh" material="davinci_metallic" mesh="wrist_pitch_0091"/>

                      <!-- PSM2 Wrist Yaw -->
                      <body name="psm2_wrist_yaw_link" pos="0.0091 0 0" quat="0.5 -0.5 -0.5 -0.5">
                        <inertial pos="0 0 0" mass="0.02" diaginertia="0.0005 0.0005 0.0005"/>
                        <joint name="psm2_wrist_yaw" range="-1.39 1.39" axis="0 0 1" damping="0.2"/>
                        <geom pos="0 0 -0.000236" type="mesh" material="davinci_dark" mesh="wrist_yaw_0091"/>

                        <!-- PSM2 Jaws (Forceps) -->
                        <body name="psm2_jaw_1_link">
                          <inertial pos="0 0 0" mass="0.01" diaginertia="0.0001 0.0001 0.0001"/>
                          <joint name="psm2_jaw_1" range="0 0.8" axis="0 0 1" damping="0.1"/>
                          <geom type="mesh" material="davinci_metallic" mesh="tip_006_1"/>
                        </body>
                        <body name="psm2_jaw_2_link">
                          <inertial pos="0 0 0" mass="0.01" diaginertia="0.0001 0.0001 0.0001"/>
                          <joint name="psm2_jaw_2" range="0 0.8" axis="0 0 -1" damping="0.1"/>
                          <geom type="mesh" material="davinci_metallic" mesh="tip_006_2"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- PSM1 Actuators (Left Arm) -->
    <position name="act_psm1_yaw" joint="psm1_yaw" kp="800" kv="80"/>
    <position name="act_psm1_pitch" joint="psm1_pitch" kp="800" kv="80"/>
    <position name="act_psm1_insertion" joint="psm1_insertion" kp="1000" kv="100"/>
    <position name="act_psm1_roll" joint="psm1_roll" kp="300" kv="30"/>
    <position name="act_psm1_wrist_pitch" joint="psm1_wrist_pitch" kp="200" kv="20"/>
    <position name="act_psm1_wrist_yaw" joint="psm1_wrist_yaw" kp="200" kv="20"/>
    <position name="act_psm1_jaw1" joint="psm1_jaw_1" kp="150" kv="15"/>
    <position name="act_psm1_jaw2" joint="psm1_jaw_2" kp="150" kv="15"/>

    <!-- PSM2 Actuators (Right Arm) -->
    <position name="act_psm2_yaw" joint="psm2_yaw" kp="800" kv="80"/>
    <position name="act_psm2_pitch" joint="psm2_pitch" kp="800" kv="80"/>
    <position name="act_psm2_insertion" joint="psm2_insertion" kp="1000" kv="100"/>
    <position name="act_psm2_roll" joint="psm2_roll" kp="300" kv="30"/>
    <position name="act_psm2_wrist_pitch" joint="psm2_wrist_pitch" kp="200" kv="20"/>
    <position name="act_psm2_wrist_yaw" joint="psm2_wrist_yaw" kp="200" kv="20"/>
    <position name="act_psm2_jaw1" joint="psm2_jaw_1" kp="150" kv="15"/>
    <position name="act_psm2_jaw2" joint="psm2_jaw_2" kp="150" kv="15"/>
  </actuator>
</mujoco>
